# FaxOCR-JS 設定
# このファイルを .env にコピーして使用:
#   cp .env.example .env
#
# .env は .gitignore に含まれ、コミットされません。

# ========================================
# 完全オフライン運用（デフォルト）
# ========================================
# 外部APIは使用しません。
# 事前に Docker で PaddleOCR を起動してください:
#   docker-compose up -d

# OCR Provider Selection
# Options: local | google | auto
# - local: Use Local OCR API (PaddleOCR in Docker) ← デフォルト
# - google: Use Google Cloud Vision API
# - auto: Try local first, fallback to Google
OCR_PROVIDER=local

# Local OCR API URL
LOCAL_OCR_API_URL=http://localhost:8765

# ========================================
# 外部API設定（オプション、通常は不要）
# ========================================

# Google Cloud Vision API Key (OCR_PROVIDER=google の場合のみ)
# GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Gemini API Key (--gemini フラグ使用時のみ)
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# Local LLM Settings (for --llm-refine flag)
# ========================================

# Enable/disable LLM text refinement
# Options: true | false (default: false, safety first)
LLM_ENABLED=false

# Local LLM API URL (OpenAI-compatible endpoint)
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_API_URL=http://localhost:1234/v1

# LLM model name (as shown in LM Studio)
# Available models: gemma3, qwen3_vl
LOCAL_LLM_MODEL=gemma3
